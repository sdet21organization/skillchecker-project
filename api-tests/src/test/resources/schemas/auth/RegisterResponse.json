{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "organizationId", "fullName", "role", "email", "active"],
  "properties": {
    "id": {
      "type": "integer"
    },
    "organizationId": {
      "type": "integer"
    },
    "fullName": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": ["admin", "recruiter", "interviewer"]
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "active": {
      "type": "boolean"
    },
    "lastLogin": {
      "type": ["string", "null"]
    },
    "autoLogin": {
      "type": "boolean"
    }
  }
}